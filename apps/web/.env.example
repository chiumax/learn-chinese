# Public app name (optional).
NEXT_PUBLIC_APP_NAME=learn-chinese

# Exact verified Google accounts allowed to use the same owner dataset.
AUTH_OWNER_EMAILS=owner@example.com,owner-alt@example.com

# Auth.js session secret (at least 32 random characters).
AUTH_SECRET=

# Google OAuth web application credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Private Hono sync service. On Railway, use its RAILWAY_PRIVATE_DOMAIN.
SYNC_SERVER_HOST=127.0.0.1
SYNC_SERVER_PORT=4000

# Must exactly match apps/server INTERNAL_SYNC_SECRET.
INTERNAL_SYNC_SECRET=
