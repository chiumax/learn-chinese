# Serwist (generated service worker)
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/swe-worker-*.js

# server: local SQLite database + drizzle output
apps/server/data/
*.db
*.db-shm
*.db-wal
apps/server/drizzle/
